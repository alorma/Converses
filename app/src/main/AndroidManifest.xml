<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Per avisar que el rellotge demana obrir una persona protegida (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ConversesApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ContactNotes">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Compartir text des d'una altra app: obre la nota ràpida amb el text posat -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Entrada «Desa a Converses» del menú de selecció de text; un àlies per no canviar el nom de l'app al launcher -->
        <activity-alias
            android:name=".ProcessTextAlias"
            android:exported="true"
            android:label="@string/import_menu_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- S'obre en tocar la notificació d'aprovació i llança el BiometricPrompt; transparent, fora de l'historial i de la tasca principal -->
        <activity
            android:name=".ui.approval.ApprovalActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.ContactNotes.Transparent" />

        <!-- Respon les peticions de «més entrades» del rellotge (només persones no protegides) -->
        <service
            android:name=".data.wear.WearEntriesService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/converses/entries"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Rep les notes dictades al rellotge i les desa com a entrades noves -->
        <service
            android:name=".data.wear.WearNoteService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/converses/note"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Rep les peticions d'aprovació d'una persona protegida i les cancel·lacions del rellotge -->
        <service
            android:name=".data.wear.WearApprovalService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/converses/approval"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/converses/approval/cancel"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

</manifest>
