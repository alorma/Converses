<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Vincle amb Contactes (docs/contacts): de moment només a debug, perquè la versió publicada no porti els
        permisos mentre la funció no estigui acabada (C12). maxSdkVersion: WRITE_CONTACTS deixa de funcionar quan es
        pugi el targetSdk per sobre del 37 (C10).
    -->
    <uses-permission
        android:name="android.permission.READ_CONTACTS"
        android:maxSdkVersion="37" />
    <uses-permission
        android:name="android.permission.WRITE_CONTACTS"
        android:maxSdkVersion="37" />

    <!-- Nom diferent perquè la versió de debug i la de release es distingeixin al launcher -->
    <application
        android:label="@string/app_name"
        tools:replace="android:label" />
</manifest>
